# `uv run python -m scripts.dev` runs everything locally with stand-ins and needs none
# of these. Set any of them in the shell to override the local defaults; in Azure,
# Terraform sets them.

# Real model: the Gemini API's free tier (a key from https://aistudio.google.com/apikey),
# or any OpenAI-compatible endpoint with JSON-schema output.
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=low

# HubSpot developer test account (a service key with contacts, companies and deals scopes).
# HUBSPOT_TOKEN=
# HUBSPOT_BASE_URL=https://api.hubapi.com
# HUBSPOT_PORTAL_ID=          # makes record links in the review page and Slack

# n8n 2.x needs Node.js 24. Point N8N_CMD at another way to start n8n if needed.
# N8N_CMD=npx --yes n8n@2.45.7
